# /etc/msxproxy/activesync-enroll.toml  (chmod 0600, root:root — loaded via systemd LoadCredential)
#
# Configuration for the optional ActiveSync DeviceID enrollment server (activesync-enroll).
# Only needed if activesync_enroll.enabled = true in /etc/msxproxy/config.lua.

[server]
host = "127.0.0.1"
port = 8000
max_body_bytes = 1048576
# Optional secret enabling raw HTML email preview (no WBXML) for browser inspection
# and live smoke tests:
#   - Via OpenResty (Basic Auth with regular password + unenrolled DeviceId):
#       https://webmail.uni-graz.at/Microsoft-Server-ActiveSync?preview_secret=<secret>&DeviceId=TEST&DeviceType=iPhone
#   - Directly on localhost:
#       http://127.0.0.1:8000/preview?secret=<secret>&subject=alice&name=Alice
# Leave empty to disable the preview endpoints.
preview_secret = ""

[enroll]
# Keycloak OIDC authorization endpoint used to build the enrollment link
authorization_endpoint = "https://login.uni-graz.at/auth/realms/UniGraz/protocol/openid-connect/auth"
client_id = "https_webmail.uni-graz.at_Enroll"
redirect_uri = "https://webmail.uni-graz.at/ActiveSync_Enroll_Complete"

# Must match the Keycloak "Enroll ActiveSync DeviceID" authenticator configuration
jwt_issuer = "https://webmail.uni-graz.at"
jwt_audience = "deviceid-enroll-authenticator"
# At least 32 bytes for HS256: openssl rand -hex 32
jwt_secret = "CHANGE_ME"
jwt_algorithm = "HS256"
token_ttl = 3600

[mail]
subject = "*** ACTION REQUIRED ***"
from_name = "uniIT Exchange ActiveSync MFA"
from_address = "noreply@uni-graz.at"

# Supported placeholders:
#   {{name}}, {{subject}}, {{email}}, {{timestamp}},
#   {{device_type}}, {{device_id}}, {{mfa_link}},
#   {{protocol_version}}, {{ua}}, {{ip}}
# All placeholders are automatically HTML-escaped inside html_template.

plain_template = """\
Sehr geehrte*r {{name}},

ein Anmeldeversuch ohne MFA von einer neuen Geräte-ID wurde erkannt.
Um den Zugriff auf Ihre E-Mails zu ermöglichen, muss dieses Gerät einmalig verifiziert werden.

Details:
- Zeitstempel: {{timestamp}}
- Gerätetyp: {{device_type}}
- Geräte-ID: {{device_id}}

Klicken Sie auf den folgenden Link, um über uniLOGIN fortzufahren:
{{mfa_link}}

Der Link ist ab dem Zeitstempel eine Stunde lang gültig.
Aktualisieren Sie Ihre E-Mails, um einen neuen Link zu erhalten.

-------------------------------English Version-------------------------------

Dear {{name}},

A login attempt without MFA from a new device ID was detected.
To enable email access, this device must be verified once.

Details:
- Timestamp: {{timestamp}}
- Device Type: {{device_type}}
- Device ID: {{device_id}}

Visit the following link to continue via uniLOGIN:
{{mfa_link}}

The link is valid for one hour from the timestamp.
Refresh your emails to get a new link.


Support & Hilfe | Support & Help:

ASK - Digitaler Assistent: ask.uni-graz.at (24/7 Support)
Telefon: +43 316 380 - 2240 (Mo-Fr: 08:00 - 16:00)
E-Mail: servicedesk@uni-graz.at
Infopoint: Universitätsstrasse 15, RESOWI-Zentrum, Bauteil GE


Informationsmanagement – uniIT | Information Management – uniIT
Universität Graz | University of Graz
https://it.uni-graz.at

---
MS-ASProtocolVersion: {{protocol_version}}
User-Agent: {{ua}}
IP Address: {{ip}}
"""

html_template = """\
<html>
<head>
