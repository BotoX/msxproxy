# Copy to docker/.env to customize your production Docker deployment.
# docker compose automatically reads docker/.env when invoked on docker/docker-compose.yml.

# Host directory containing config.lua, s4u2api.toml, mailproxy.toml,
# activesync-enroll.toml (optional), krb5_keytab, ssl/*.pem|*.key, and optional ca/*.crt
MSXPROXY_ETC_DIR=/etc/msxproxy

# Host Kerberos configuration file mounted read-only into s4u2api
KRB5_CONF=/etc/krb5.conf

# Optional: set to "activesync-enroll" to always include the activesync-enroll container
# COMPOSE_PROFILES=activesync-enroll

# Optional: override DNS resolver(s) for OpenResty Lua cosockets (default: auto from host /etc/resolv.conf)
# OPENRESTY_RESOLVER=143.50.x.x valid=30s

# Worker counts and log levels
S4U2API_WORKERS=1
S4U2API_LOG_LEVEL=INFO
S4U2API_PORT=7777

MAILPROXY_WORKERS=1
MAILPROXY_LOG_LEVEL=INFO

# OpenResty NTLM dynamic module build source
# NTLM_MODULE_REPO=https://github.com/BotoX/upstream-ntlm-nginx-module.git
# NTLM_MODULE_REF=master
